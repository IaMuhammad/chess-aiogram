# Copy this file to ".env" and fill in your values.

# ── Required to run the Telegram bot ─────────────────────────────────
# Get a token from @BotFather (/newbot). Leave empty to run API-only in dev.
BOT_TOKEN=
z
# Your bot's username (without @). Used to build friend-invite deep links.
BOT_USERNAME=

# The Mini App short name you set in @BotFather (/newapp). Default: play
WEBAPP_SHORT_NAME=play

# ── Where the frontend (Mini App) is served ──────────────────────────
# Telegram requires HTTPS. For local development, expose the Vite dev server
# (port 5173) with a tunnel, e.g.:  cloudflared tunnel --url http://localhost:5173
# then put that https URL here.
WEBAPP_URL=http://localhost:5173

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./chess.db

# ── Behaviour ────────────────────────────────────────────────────────
# DEV_MODE=true skips Telegram signature checks so you can open the app in a
# normal browser. NEVER use true in production.
DEV_MODE=true
RUN_BOT=true

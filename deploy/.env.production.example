# Production environment for the server at 178.105.193.47.
# Copied to the server as /opt/chess/.env with the real BOT_TOKEN filled in.
# The real file is NOT in the repo — it holds the bot token.

# ── Telegram ─────────────────────────────────────────────────────────
# From @BotFather. Only one process may poll a given token at a time.
BOT_TOKEN=
BOT_USERNAME=
WEBAPP_SHORT_NAME=play

# ── Public URL ───────────────────────────────────────────────────────
# sslip.io resolves <ip>.sslip.io -> <ip>, which lets Let's Encrypt issue a
# real cert without owning a domain. Telegram requires HTTPS here.
WEBAPP_URL=https://178.105.193.47.sslip.io
CORS_ORIGINS=https://178.105.193.47.sslip.io

# ── Server ───────────────────────────────────────────────────────────
# Binds inside the container; nginx is the only thing that reaches it.
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────
# Overridden by docker-compose to point at the /data volume.
DATABASE_URL=sqlite+aiosqlite:////data/chess.db

# ── Behaviour ────────────────────────────────────────────────────────
# MUST be false in production: true disables Telegram signature checks and
# lets anyone impersonate any user.
DEV_MODE=false
RUN_BOT=true

# Frontend (Vite) environment. Copy to ".env" and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Backend the dev server proxies /api, /ws and /health to.
# Used by vite.config.js during `npm run dev`.
VITE_BACKEND_URL=http://localhost:8000

# Optional. Absolute base for API/WS calls. Leave EMPTY to use same-origin
# relative URLs ("/api", "/ws") — the default and what production should use
# (FastAPI serves the built frontend). Set this only when the frontend is
# hosted separately from the backend, e.g. https://api.example.com
VITE_API_BASE=

# Comma-separated hostnames allowed to reach the dev server. Needed when
# accessing it through a tunnel (e.g. frontend.jprq.live). Use "*" for any host.
VITE_ALLOWED_HOSTS=

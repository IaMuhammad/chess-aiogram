# Local override (highest Vite priority, overrides .env).
# Backend stays local: the Vite proxy runs server-side, so http://localhost:8000
# works even when the frontend is reached through the jprq tunnel.
VITE_BACKEND_URL=http://localhost:8000
# Allow both the tunnel host and localhost so either access path works.
# (Use "*" to allow any host.)
VITE_ALLOWED_HOSTS=frontend.jprq.live,localhost,127.0.0.1
